# Slate Runner Demo - Environment Variables
# Copy this to .env and fill in your values

# S3/Tigris Configuration (Required)
AWS_ENDPOINT_URL=https://fly.storage.tigris.dev
AWS_ACCESS_KEY_ID=tid_your_key_here
AWS_SECRET_ACCESS_KEY=tsec_your_secret_here
AWS_REGION=auto

# Cloud Provider (auto-detected if not set)
# Options: aws, gcp, azure, custom
# CLOUD_PROVIDER=aws

# Control Plane S3 Bucket Configuration
CONTROL_PLANE_BUCKET=slate-demo-meta
CONTROL_PLANE_BUCKET_PREFIX=

# Runner S3 Bucket Configuration (for SlateDB storage)
RUNNER_BUCKET=slate-demo-runner
RUNNER_BUCKET_PREFIX=

# Legacy: These still work for backward compatibility
# SLATE_META_BUCKET=slate-demo-meta  (use CONTROL_PLANE_BUCKET instead)
# SLATE_RUNNER_BUCKET=slate-demo-runner  (use RUNNER_BUCKET instead)
# BUCKET_PREFIX=  (use CONTROL_PLANE_BUCKET_PREFIX or RUNNER_BUCKET_PREFIX instead)

# Runner Configuration (Optional - has defaults)
# If not provided, RUNNER_ID and RUNNER_NAME will be auto-generated
# Examples of auto-generated names: "brave-falcon", "swift-eagle", "noble-tiger"
RUNNER_ID=
RUNNER_NAME=
CONTROL_PLANE_URL=http://localhost:5005
POLL_INTERVAL=60  # Check for jobs every 60 seconds (1 minute)

# Terraform Configuration
TF_VERSION=1.14.3
TF_INSTALL_DIR=/tmp/terraform-versions

# Control Plane Configuration (Optional)
PORT=5005
SECRET_KEY=dev-secret-key

# Terraform Environment Variables (Optional - if your TF needs them)
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_DEFAULT_REGION=us-west-2